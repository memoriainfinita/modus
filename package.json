{
  "name": "modus",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --outfile=dist/app.js --format=iife --sourcemap",
    "dev": "esbuild src/app.ts --bundle --outfile=dist/app.js --format=iife --sourcemap --watch=forever",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^24.0.0",
    "@types/node": "^20.0.0"
  }
}
