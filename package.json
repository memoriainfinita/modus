{
  "name": "modus",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --outfile=dist/app.js --format=iife --sourcemap && pnpm build:worker",
    "build:worker": "esbuild src/audio-notes/worker.ts --bundle --minify --outfile=dist/notes-worker.js --format=iife",
    "dev": "esbuild src/app.ts --bundle --outfile=dist/app.js --format=iife --sourcemap --watch=forever",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "bench:audio": "node scripts/bench/run.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test:e2e:midi": "node --disable-warning=ExperimentalWarning tests/e2e/real-midi.mjs"
  },
  "devDependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "jzz": "^1.9.6",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "umt": "github:memoriainfinita/UMT#v0.10.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
