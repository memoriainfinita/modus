    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "umt": "github:memoriainfinita/UMT#2e867c4197578e7fde13600ad8938d06d2c4b3c2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
